### Settings from original zathurarc ###
set guioptions s
set statusbar-home-tilde true
set selection-clipboard clipboard
set adjust-open width
set first-page-column 1
set incremental-search false
unmap i
set font "JetBrains Mono 10"
map \< goto top
map \> goto bottom
map b navigate previous
map e follow
map f navigate next
map d toggle_page_mode
map p goto top
map [normal]     <C-l> reload
map [fullscreen] <C-l> reload
map <C-+> zoom in
map <C--> zoom out
map <C-=> zoom in
map <C-)> adjust_window best-fit
map <C-0> adjust_window width
map <C-a> scroll full-left
map <C-b> scroll left
map [normal]     e scroll full-right
map [fullscreen] e scroll full-right
map <C-e> scroll full-right
map <C-f> scroll right
map <C-g> abort
map <C-n> scroll down
map <C-p> scroll up
map <C-v> scroll full-down
map [normal]     <C-e> scroll down
map [fullscreen] <C-e> scroll down
map [normal]     y scroll up
map [fullscreen] y scroll up
map [normal]     <C-y> scroll up
map [fullscreen] <C-y> scroll up
map <A-\<> goto top
map <A-\>> goto bottom
map <A-v> scroll full-up
unmap u
map u scroll half-up
set window-title-basename true

### zathura-pywal ###
# Allow recolor
set recolor 'true'

# Don't allow original hue when recoloring
set recolor-keephue 'false'

# Don't keep original image colors while recoloring
set recolor-reverse-video 'false'

# Command line completion entries
set completion-fg '#dee2d3'
set completion-bg '#171110'

# Command line completion group elements
set completion-group-fg '#828D6E'
set completion-group-bg '#171110'

# Current command line completion element
set completion-highlight-fg '#171110'
set completion-highlight-bg '#dee2d3'

# Default foreground/background color
set default-bg rgba(23,17,16,1)

# Input bar
set inputbar-fg '#dee2d3'
set inputbar-bg '#171110'

# Notification
set notification-fg '#dee2d3'
set notification-bg '#171110'

# Error notification
set notification-error-fg '#dee2d3'
set notification-error-bg '#AE9853'

# Warning notification
set notification-warning-fg '#dee2d3'
set notification-warning-bg '#AE9853'

# Tab - TODO
# set tabbar-fg
# set tabbar-bg

# Focused tab - TODO
# set tabbar-focus-fg
# set tabbar-focus-bg

# Status bar
set statusbar-fg '#dee2d3'
set statusbar-bg '#171110'

# Highlighting parts of the document (e.g. show search results)

set highlight-color rgba(255,255,0,0.3)   # pale yellow background

# Text color for highlighted search terms
set highlight-fg rgba(0,0,0,1)             # solid black text

set highlight-active-color rgba(255,0,0,0.3)  

# Represent light/dark colors in recoloring mode
set recolor-lightcolor rgba(0,0,0,0)
set recolor-darkcolor '#dee2d3'

# 'Loading...' text
set render-loading-fg '#dee2d3'
set render-loading-bg '#171110'

# Index mode
set index-fg '#dee2d3'
set index-bg '#171110'

# Selected element in index mode
set index-active-fg '#171110'
set index-active-bg '#dee2d3'