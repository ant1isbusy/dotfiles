{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
     "display": {
       "separator": " ~   ",
       "color": {
         "separator": "blue"
       },
  },
    "modules": [
       "break", "break", "break",
           "break", "break", "break",

       {
         "key" : "Packages  ",
         "type": "packages",
         "keyColor": "blue"
       },
       {
         "key" : "Shell     ",
         "type": "shell",
         "keyColor": "blue",
         "format": "{1} {4}"
       },
       {
         "key" : "WM        ",
         "type": "wm",
         "keyColor": "blue",
         "format": "{2} ({3})"
       },
       {
         "key" : "Memory    ",
         "type": "memory",
         "keyColor": "blue",
         "format": "{1} / {2}"
       },
       {
         "key" : "Disk      ",
         "type": "disk",
         "keyColor": "blue",
         "format": "{1} / {2}"
       },
       "break",
       {
         "key" : "CPU       ",
         "type": "cpu",
         "keyColor": "blue",
         "format": "{1}"
       },
       {
         "key" : "GPU       ",
         "type": "gpu",
         "keyColor": "blue",
         "format": "{2}",
         "hideType": "integrated"
       },
       {
         "key": "Uptime    ",
         "type": "uptime",
         "keyColor": "blue",
       },
       "break","break",

     ]
}
